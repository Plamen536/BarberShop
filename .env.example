# Копирай този файл като .env.local и попълни стойностите от
# Firebase Console -> Project settings -> Your apps -> Web app (SDK config).
# Без тези стойности сайтът работи в ДЕМО режим (localStorage).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=barbershop-d95f5
VITE_FIREBASE_APP_ID=

# Парола за админ панела САМО в демо режим (по подразбиране: admin)
VITE_ADMIN_DEMO_PASSWORD=admin
